# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ethiobet
DB_POOL_MIN=2
DB_POOL_MAX=10

# Server
PORT=3000
NODE_ENV=production

# Telebirr RSA Keys (base64 encoded)
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key_base64
TELEBIRR_PRIVATE_KEY=your_private_key_base64
TELEBIRR_APP_ID=your_app_id
TELEBIRR_APP_KEY=your_app_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_NOTIFY_URL=https://yourdomain.com/api/payments/telebirr-webhook

# Security
WEBHOOK_TOLERANCE_SECONDS=300

# Odds API (https://the-odds-api.com - free tier: 500 req/month)
ODDS_API_KEY=your_odds_api_key

# Africa's Talking SMS (https://africastalking.com)
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=EthioBet

# Frontend URL (for CORS)
FRONTEND_URL=https://yourdomain.com
